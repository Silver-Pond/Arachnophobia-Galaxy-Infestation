<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white"> <!-- Define your desired ripple color -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" /> <!-- This color is for the mask, it defines the shape of the ripple -->
        </shape>
    </item>
    <!-- Optional: Define the background of the button when not pressed -->
    <item android:drawable="@drawable/custom_button" />
</ripple>